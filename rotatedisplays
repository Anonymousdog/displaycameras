#!/bin/bash
# Rotates camera feeds through window positions in a loop.
# Upstream design: runs 11 cycles then forks a fresh copy to prevent
# bash process bloat on long-running headless Pi systems. The PID changes
# but pkill rotatedisplays (used in stop/repair) matches by name.
for i in `seq 1 11`; do
sleep $1
seq_step="$2"
if [ "$seq_step" -gt 1 ]; then
        /usr/bin/displaycameras rotaterev >/dev/null 2>&1
        else
                /usr/bin/displaycameras rotate >/dev/null 2>&1
fi
done
$0 $1 $2 &
exit 0
